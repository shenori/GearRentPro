<?xml version="1.0" encoding="UTF-8"?>
<project name="GearRentPro" default="default" basedir=".">
    <description>Builds, tests, and runs the project GearRentPro.</description>

    <!-- ✅ CHANGE THIS to your actual JavaFX SDK path -->
    <property name="javafx.home" value="C:/javafx-sdk-21/lib"/>

    <import file="nbproject/build-impl.xml"/>

    <target name="-pre-compile">
        <property name="javac.compilerargs"
                  value="--module-path &quot;${javafx.home}&quot; --add-modules javafx.controls,javafx.fxml,javafx.base,javafx.graphics"/>
    </target>

    <target name="-post-jar">
        <!-- Ensures JavaFX is on module path at runtime too -->
    </target>

</project>