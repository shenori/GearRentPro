<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gearrentpro.controller.BranchController"
            styleClass="content-pane">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Top: Title and Add Button -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Branch Management" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Add New Branch" onAction="#handleAddBranch" styleClass="primary-button"/>
        </HBox>
    </top>

    <!-- Center: Split into Table and Form -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20"/>
            </padding>

            <!-- Left: Table -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <TableView fx:id="branchTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80">
                            <cellValueFactory>
                                <PropertyValueFactory property="branchId"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colName" text="Branch Name" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="name"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAddress" text="Address" prefWidth="200">
                            <cellValueFactory>
                                <PropertyValueFactory property="address"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colContact" text="Contact" prefWidth="120">
                            <cellValueFactory>
                                <PropertyValueFactory property="contact"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="80">
                            <cellValueFactory>
                                <PropertyValueFactory property="active"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right: Form -->
            <VBox spacing="15" minWidth="350" styleClass="form-panel">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label fx:id="formTitle" text="Add New Branch" styleClass="form-title"/>

                <VBox spacing="5">
                    <Label text="Branch ID"/>
                    <TextField fx:id="txtBranchId" editable="false" styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Branch Name *"/>
                    <TextField fx:id="txtName" promptText="Enter branch name" styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Address *"/>
                    <TextArea fx:id="txtAddress" promptText="Enter full address" 
                              prefRowCount="3" styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Contact Number *"/>
                    <TextField fx:id="txtContact" promptText="e.g., 011-2234567" styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <CheckBox fx:id="chkActive" text="Active" selected="true"/>
                </VBox>

                <Label fx:id="lblError" styleClass="error-label" wrapText="true"/>

                <HBox spacing="10">
                    <Button fx:id="btnSave" text="Save" onAction="#handleSave" styleClass="primary-button"/>
                    <Button fx:id="btnUpdate" text="Update" onAction="#handleUpdate" 
                            styleClass="primary-button" visible="false" managed="false"/>
                    <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
                    <Button fx:id="btnDelete" text="Delete" onAction="#handleDelete" 
                            styleClass="danger-button" visible="false" managed="false"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>